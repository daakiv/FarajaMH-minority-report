{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:farajamh:schema:manifest:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "community_validated": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "dataset",
    "count",
    "description",
    "community_validated"
  ],
  "additionalProperties": false
}
